{
  "name": "@awlpay/sdk",
  "version": "0.1.0",
  "description": "AwLPay TypeScript SDK — client for the live /api/pay routes; fees mirror CuNi FeeManager",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fees": {
      "types": "./dist/fees.d.ts",
      "import": "./dist/fees.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/fees.test.ts test/router.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0",
  "private": true
}
